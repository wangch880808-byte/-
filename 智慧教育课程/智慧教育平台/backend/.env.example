# Copy to .env in this directory. Keep .env out of Git.
# Use an isolated database that already contains the RuoYi sys_* and QRTZ_* tables.
# Values are literal text; do not wrap them in quotes.
RUOYI_DB_URL=
RUOYI_DB_USERNAME=
RUOYI_DB_PASSWORD=
RUOYI_TOKEN_SECRET=
RUOYI_REDIS_HOST=localhost
RUOYI_REDIS_PORT=6379
RUOYI_REDIS_DATABASE=15
RUOYI_REDIS_PASSWORD=
# Optional: pin the JDK used by run-local.ps1, e.g. C:\path\to\jdk-17.
# RUOYI_JAVA_HOME=
# Optional on Windows if Java 21 reports "Unable to establish loopback connection".
# Point to an existing short, ASCII-only local directory.
# RUOYI_JAVA_UNIXDOMAIN_TMPDIR=C:\path\to\uds
