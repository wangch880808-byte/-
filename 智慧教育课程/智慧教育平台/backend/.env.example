# Copy to backend/.env and fill your private credentials. Values are not quoted.
RUOYI_DB_URL=jdbc:mysql://127.0.0.1:3306/smart_edu_g12?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&forceConnectionTimeZoneToSession=true
RUOYI_DB_USERNAME=root
RUOYI_DB_PASSWORD=
# Production must set a strong random secret; the built-in default in application.yml is for local startup only.
RUOYI_TOKEN_SECRET=
RUOYI_REDIS_HOST=127.0.0.1
RUOYI_REDIS_PORT=6379
RUOYI_REDIS_DATABASE=14
RUOYI_REDIS_PASSWORD=
RUOYI_UPLOAD_PATH=./data/uploads

# JVM Unix domain socket workaround for local Windows environments.
# RUOYI_JAVA_UNIXDOMAIN_TMPDIR=C:\path\to\uds
# Optional: upload root directory. Defaults to D:/ruoyi/uploadPath; on Linux use /home/ruoyi/uploadPath.
# RUOYI_PROFILE=D:/ruoyi/uploadPath
