# 复制为 backend/.env 后填写。不要提交 .env。
# 值原样书写，不要加引号。

# ---- 必填 ----
# 推荐库名 zhijiao_m0；可用 sql/zhijiao-m0-all-in-one.sql 一键初始化
RUOYI_DB_URL=jdbc:mysql://127.0.0.1:3306/zhijiao_m0?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
RUOYI_DB_USERNAME=root
RUOYI_DB_PASSWORD=
# 随机长密钥（建议 64 位十六进制）
RUOYI_TOKEN_SECRET=

# ---- Redis（必填可达；密码可空）----
RUOYI_REDIS_HOST=localhost
RUOYI_REDIS_PORT=6379
RUOYI_REDIS_DATABASE=15
RUOYI_REDIS_PASSWORD=

# ---- 可选 ----
# 上传目录（对应 ruoyi.profile）
# RUOYI_PROFILE=D:/zhijiao/uploadPath
# HTTP 端口（默认 8080）
# SERVER_PORT=8080
# 令牌有效期分钟（默认 30）
# TOKEN_EXPIRE_MINUTES=30
# 日志级别
# LOG_LEVEL_RUOYI=info
# LOG_LEVEL_EDUCATION=debug
# SWAGGER_ENABLED=true
# Windows 上 Java 21 UDS 临时目录（短 ASCII 路径）
# RUOYI_JAVA_UNIXDOMAIN_TMPDIR=C:\path\to\uds
# 课件预览本地根目录（edu_resource_page.preview_storage_key 相对此目录）
# 不填则预览接口返回 503
# ZHIJIAO_PREVIEW_ROOT=D:\path\to\preview-storage
