<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.education.mapper.EduCourseSpaceMapper">

    <resultMap id="CourseSpaceResult" type="com.ruoyi.education.domain.EduCourseSpace">
        <id     property="id"                 column="id"/>
        <result property="organizationId"     column="organization_id"/>
        <result property="officialCourseId"   column="official_course_id"/>
        <result property="ownerUserId"        column="owner_user_id"/>
        <result property="title"              column="title"/>
        <result property="summary"            column="summary"/>
        <result property="learningObjectives" column="learning_objectives"/>
        <result property="status"             column="status"/>
    </resultMap>

    <sql id="selectVo">
        SELECT id, organization_id, official_course_id, owner_user_id,
        title, summary, learning_objectives, status
        FROM edu_course_space
    </sql>

    <!-- 老师查自己创建的课 -->
    <select id="selectByOwnerUserId" resultMap="CourseSpaceResult">
        <include refid="selectVo"/>
        WHERE owner_user_id = #{userId}
        ORDER BY id DESC
    </select>

    <!-- 管理员查所有课 -->
    <select id="selectAll" parameterType="com.ruoyi.education.domain.EduCourseSpace" resultMap="CourseSpaceResult">
        <include refid="selectVo"/>
        <where>
            <if test="title != null and title != ''"> AND title LIKE concat('%', #{title}, '%')</if>
            <if test="status != null and status != ''"> AND status = #{status}</if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" parameterType="Long" resultMap="CourseSpaceResult">
        <include refid="selectVo"/> WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.ruoyi.education.domain.EduCourseSpace"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO edu_course_space(organization_id, official_course_id, owner_user_id,
        title, summary, learning_objectives, status)
        VALUES (#{organizationId}, #{officialCourseId}, #{ownerUserId},
        #{title}, #{summary}, #{learningObjectives}, #{status})
    </insert>

    <update id="update" parameterType="com.ruoyi.education.domain.EduCourseSpace">
        UPDATE edu_course_space
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="learningObjectives != null">learning_objectives = #{learningObjectives},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
